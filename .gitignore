# ============================================================
#  Live Location Tracking System — .gitignore
# ============================================================

# ── Python / Backend ─────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# SQLite database (local dev only)
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# Uvicorn / FastAPI logs
*.log

# ── Environment & Secrets ────────────────────────────────────
# NEVER commit API keys or credentials
.env
.env.local
.env.development
.env.production
.env.staging
backend/.env
frontend/.env

# Keep example files (no secrets)
!.env.example
!backend/.env.example
!frontend/.env.example

# ── Node / Frontend ──────────────────────────────────────────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite build output
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ── OS Artifacts ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Test Artifacts ───────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Misc ─────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
fetch_location.py
